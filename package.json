{
  "name": "atlas-data-science",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas visual e interactivo de los conceptos de la ciencia de datos.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:validate && node scripts/build-content.ts --production && tsc -b --noEmit && vite build && node scripts/copy-404.ts",
    "preview": "vite preview",
    "content:build": "node scripts/build-content.ts",
    "content:validate": "node scripts/validate-content.ts",
    "content:report": "node scripts/content-report.ts",
    "check:typography": "node scripts/check-typography.ts",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests .github README.md \"*.{ts,js,json,html}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run check:typography && npm run content:validate && npm run test",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run typecheck && npm run check:typography && npm run content:validate",
    "preserveUnused": [
      "commit-msg"
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.8",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-force": "^3.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.9",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "katex": "$katex"
  }
}
